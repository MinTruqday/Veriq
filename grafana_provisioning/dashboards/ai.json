{
  "title": "Veriq AI",
  "tags": ["ai", "knowledge"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Active Agent Sessions",
      "type": "stat",
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "veriq_agent_active_sessions", "legendFormat": "Active"}]
    },
    {
      "title": "LLM Calls in Active Sessions",
      "type": "stat",
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "veriq_agent_llm_calls_total", "legendFormat": "LLM calls"}]
    },
    {
      "title": "Tokens in Active Sessions",
      "type": "stat",
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "veriq_agent_tokens_total", "legendFormat": "Tokens"}]
    },
    {
      "title": "Security Violations in Active Sessions",
      "type": "stat",
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "veriq_agent_security_violations_total", "legendFormat": "Violations"}]
    },
    {
      "title": "Tool Calls in Active Sessions",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "targets": [{"expr": "veriq_agent_tool_calls_total", "legendFormat": "Tool calls"}]
    },
    {
      "title": "Average Tool Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "targets": [{"expr": "veriq_agent_tool_avg_latency_ms", "legendFormat": "{{tool}}"}]
    },
    {
      "title": "AI API Average Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "targets": [{"expr": "sum(rate(http_request_duration_seconds_total{service=\"ai\"}[5m])) / clamp_min(sum(rate(http_requests_total{service=\"ai\"}[5m])), 1e-9)", "legendFormat": "Average seconds"}]
    },
    {
      "title": "AI API 5xx Errors",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "targets": [{"expr": "sum(rate(http_errors_total{service=\"ai\"}[5m]))", "legendFormat": "Errors / second"}]
    }
  ]
}
